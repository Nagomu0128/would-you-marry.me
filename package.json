{
  "name": "would-you-marry-me",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @wym/db generate",
    "db:migrate:local": "pnpm --filter @wym/admin db:migrate:local",
    "db:migrate:remote": "pnpm --filter @wym/admin db:migrate:remote",
    "deploy:guest": "pnpm --filter @wym/guest deploy:production",
    "deploy:admin": "pnpm --filter @wym/admin deploy:production"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3"
  }
}
