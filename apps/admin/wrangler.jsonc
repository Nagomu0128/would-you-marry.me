// admin Worker（admin.would-you-marry.me）: 管理面の画面と API、Better Auth、Cron Triggers
// 本番は env.production に書く（`CLOUDFLARE_ENV=production` でビルド・デプロイする。docs/runbook.md）。
// Wrangler の環境では bindings・vars が継承されないため、本番に必要なものをすべて書き直している
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wym-admin",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wym",
      // ローカル用の仮の値。本番の ID は env.production に書く
      "database_id": "00000000-0000-0000-0000-000000000000",
      // D1 のマイグレーションは 2 つの Worker で共有するので、admin から適用する
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "wym-files"
    }
  ],
  "triggers": {
    // UTC 18:00 = 日本時間 3:00（1 日 1 回、仮置き）
    "crons": ["0 18 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GUEST_ORIGIN": "http://localhost:5173",
    // admin 自身のオリジン。Better Auth の baseURL・trustedOrigins になる
    "ADMIN_ORIGIN": "http://localhost:5174",
    "ADMIN_EMAILS": "admin@example.com"
  },
  "env": {
    "production": {
      "name": "wym-admin",
      // Kyoshidk@gmail.com's Account
      "account_id": "fadb16b194dd31d1f11d932096752858",
      "routes": [{ "pattern": "admin.would-you-marry.me", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wym",
          // `wrangler d1 create wym` で得た ID に置き換える（docs/runbook.md）
          "database_id": "673f04af-e30e-4bf4-b3fc-ed4ee152136b",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "wym-files"
        }
      ],
      "triggers": {
        // UTC 18:00 = 日本時間 3:00（1 日 1 回、仮置き）
        "crons": ["0 18 * * *"]
      },
      "observability": {
        "enabled": true
      },
      "vars": {
        "GUEST_ORIGIN": "https://would-you-marry.me",
        "ADMIN_ORIGIN": "https://admin.would-you-marry.me"
        // ADMIN_EMAILS（管理者の許可リスト）はシークレットで登録する。
        // このリポジトリは公開されているため、メールアドレスを設定ファイルに書かない（docs/runbook.md）
      }
    }
  }
}
